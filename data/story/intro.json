{
  "id": "intro",
  "comment": "Opening cinematic (ten years before the game). Every illustration is 480x268, shown 1:1 in the same letterbox. Scenes 1-4: the protagonist is about eight; hair turns partly silver only during scene 3 (crossfade 3 -> 3b). Scene 5: arrival, Eldric about ten years younger. Then the title and the time skip. See scripts/story/cinematic.gd for the beat types. Localize by adding intro.<locale>.json.",
  "speakers": {
    "narrator": { "color": "#e8dec4" },
    "authority": { "color": "#b8c4dc", "quotes": true },
    "eldric": { "color": "#e2c08a", "quotes": true }
  },
  "scenes": [
    {
      "image": "res://assets/story/intro_1.png",
      "fade_in": 3.0,
      "pan": [0.0, 1.0],
      "fog": "low",
      "motes": "dust",
      "ambience": "amb_hall",
      "beats": [
        { "wait": 1.5 },
        { "line": "Dans le monde où je suis né, chaque âme portait une inscription." },
        { "line": "Un nom que nul ne pouvait effacer." },
        { "line": "Une preuve de notre existence." },
        { "wait": 1.4 },
        { "line": "Mais moi..." },
        { "line": "Je n'en avais aucune." },
        { "wait": 1.2 }
      ]
    },
    {
      "image": "res://assets/story/intro_2.png",
      "fade_in": 1.6,
      "pan": [0.0, 0.9],
      "fog": "low",
      "motes": "dust",
      "beats": [
        { "wait": 0.8 },
        { "line": "Je ne comprenais pas pourquoi ils avaient peur de moi." },
        { "line": "Je n'avais fait de mal à personne." },
        { "dim": { "amount": 0.25, "time": 8.0 } },
        { "line": "Pourtant, ils ont effacé mon nom." },
        { "line": "Et interdit à ceux que j'aimais de me revoir." },
        { "wait": 0.8 },
        { "line": "Une âme sans inscription ne peut appartenir à notre monde.", "speaker": "authority" },
        { "sfx": "clang", "shake": 2.0 },
        { "line": "Tu seras rejeté au-delà de ses frontières.", "speaker": "authority" },
        { "wait": 1.0 }
      ]
    },
    {
      "image": "res://assets/story/intro_3.png",
      "fade_in": 1.6,
      "pan": [0.2, 0.75],
      "fog": "none",
      "motes": "sparks",
      "ambience": "amb_ritual",
      "beats": [
        { "wait": 0.8 },
        { "runes": { "center": [240, 196], "radius": [142, 34], "count": 20, "speed": 0.04, "fade": 4.0, "intensity": 0.6 } },
        { "line": "Je me souviens du froid." },
        { "line": "Du silence." },
        { "line": "Et de cette sensation..." },
        { "crossfade": { "image": "res://assets/story/intro_3b.png", "time": 5.0 },
          "runes": { "center": [240, 196], "radius": [142, 34], "count": 24, "speed": 0.08, "fade": 3.0, "intensity": 1.0 } },
        { "line": "Comme si quelque chose essayait de m'effacer." },
        { "line": "Que l'existence elle-même te rejette.", "speaker": "authority" },
        { "sfx": "ritual", "flash": 0.7, "shake": 3.0 },
        { "wait": 0.6 },
        { "line": "Puis tout a disparu." },
        { "runes_off": 1.0, "fade_out": 1.4 }
      ]
    },
    {
      "image": "res://assets/story/intro_4.png",
      "fade_in": 1.6,
      "pan": [0.0, 1.0],
      "fog": "void",
      "motes": "void",
      "ambience": "amb_void",
      "beats": [
        { "sfx": "void", "wait": 1.4 },
        { "line": "Je pensais que j'allais mourir." },
        { "line": "Que personne ne se souviendrait de moi." },
        { "wait": 1.6 },
        { "line": "Mais au-delà du vide..." },
        { "line": "Il existait un autre monde." },
        { "wait": 0.6 }
      ],
      "fade_out_color": "white"
    },
    {
      "image": "res://assets/story/intro_5.png",
      "fade_in": 2.4,
      "fade_in_color": "white",
      "pan": [0.0, 0.6],
      "fog": "low",
      "motes": "dust",
      "ambience": "amb_meadow",
      "beats": [
        { "wait": 2.0 },
        { "line": "Je ne savais pas où j'étais." },
        { "line": "Je ne connaissais ni cette terre..." },
        { "line": "...ni ceux qui y vivaient." },
        { "wait": 1.4 },
        { "line": "Mais ce jour-là..." },
        { "crossfade": { "image": "res://assets/story/intro_5b.png", "time": 3.0 } },
        { "line": "Quelqu'un m'a trouvé." },
        { "line": "Par les anciennes pierres...", "speaker": "eldric" },
        { "line": "Qu'est-ce qu'un enfant fait ici, tout seul ?", "speaker": "eldric" },
        { "wait": 1.2 },
        { "line": "Doucement... Tu es en sécurité.", "speaker": "eldric" },
        { "fade_out": 2.0 },
        { "title": { "image": "res://assets/ui/logo_asthya.png", "hold": 3.0 } },
        { "caption": { "text": "Dix années plus tard.", "hold": 2.6 } }
      ]
    }
  ]
}
