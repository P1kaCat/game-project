[node name="TestWorld" type="Node2D"]
script = ExtResource("1_world")

[node name="Terrain" type="TileMapLayer" parent="."]
texture_filter = 1
script = ExtResource("2_terrain")

[node name="Entities" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Obstacles" type="TileMapLayer" parent="Entities"]
texture_filter = 1
y_sort_enabled = true
script = ExtResource("3_obstacles")

[node name="Player" parent="Entities" instance=ExtResource("4_player")]

[node name="Eldric" parent="Entities" instance=ExtResource("7_npc")]
definition = ExtResource("8_eldric")

[node name="Camera" type="Camera2D" parent="." node_paths=PackedStringArray("target")]
script = ExtResource("5_camera")
target = NodePath("../Entities/Player")

[node name="MobileHUD" parent="." instance=ExtResource("6_hud")]

[node name="InteractionDirector" type="Node" parent="." node_paths=PackedStringArray("player", "camera", "hud")]
script = ExtResource("9_director")
player = NodePath("../Entities/Player")
camera = NodePath("../Camera")
hud = NodePath("../MobileHUD")
