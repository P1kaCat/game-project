; Engine configuration file.
; Godot 4 project — isometric pixel-art RPG prototype.

config_version=5

[application]

config/name="Isometric RPG Prototype"
config/description="Player character movement test on a 64x32 isometric grid."
run/main_scene="res://scenes/launcher.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/version="0.5.1"

[autoload]

PixelScaler="*res://scripts/core/pixel_scaler.gd"
GameInput="*res://scripts/input/game_input.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

